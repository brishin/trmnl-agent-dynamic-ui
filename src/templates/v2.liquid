<style>
/* DESIGN_TOKENS */

.dui,.dui * {box-sizing:border-box;font-family:Arial,Helvetica,sans-serif!important;}
.dui {height:100%;width:100%;padding:20px 24px 12px;display:flex;flex-direction:column;color:#000;overflow:hidden;}
.dui-head {display:flex;justify-content:space-between;align-items:center;border-top:5px solid #000;padding-top:10px;gap:15px;flex:0 0 36px;}
.dui-heading {font-size:var(--ui-meta-size);line-height:var(--ui-meta-leading);font-weight:750;letter-spacing:1px;text-transform:uppercase;}
.dui-date {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);letter-spacing:0;white-space:nowrap;}
.dui-main {flex:1;min-height:0;display:grid;gap:20px;margin-top:22px;margin-bottom:16px;}
.dui-block {min-width:0;min-height:0;overflow:hidden;overflow-wrap:anywhere;}
.dui-label {font-size:var(--ui-meta-size);line-height:var(--ui-meta-leading);font-weight:750;letter-spacing:1px;text-transform:uppercase;margin-bottom:10px;}
.dui-body {font-size:19px;line-height:1.4;overflow-wrap:anywhere;}
.dui-value {font-size:60px;font-weight:780;line-height:1.05;letter-spacing:-3px;margin:0 0 8px;white-space:nowrap;}
.dui-sub {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);}
.dui-list {display:flex;flex-direction:column;gap:12px;}
.dui-item {font-size:17px;line-height:23px;display:flex;gap:12px;}
.dui-index {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:23px;flex:0 0 23px;}
.dui-event {display:grid;grid-template-columns:85px 1fr;gap:10px;padding:9px 0;border-top:1px solid #000;align-items:baseline;}
.dui-time {font-size:18px;font-weight:750;line-height:23px;}
.dui-event-text {font-size:17px;line-height:23px;}
.dui-table {width:100%;table-layout:fixed;border-collapse:collapse;font-size:var(--ui-meta-size);font-weight:600;line-height:22px;}
.dui-table th {text-align:left;font-size:var(--ui-meta-size);font-weight:700;text-transform:uppercase;letter-spacing:.8px;padding:0 5px 7px 0;border-bottom:2px solid #000;}
.dui-table td {padding:10px 5px 10px 0;border-bottom:1px solid #000;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.dui-cal-item {display:grid;grid-template-columns:64px 1fr;gap:16px;align-items:center;padding:10px 0;border-top:1px solid #000;}
.dui-cal-leaf {display:flex;flex-direction:column;align-items:center;white-space:nowrap;}
.dui-cal-month {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:18px;letter-spacing:1px;text-transform:uppercase;}
.dui-cal-day {font-size:42px;font-weight:780;line-height:1;letter-spacing:-1.5px;}
.dui-cal-text {font-size:18px;line-height:23px;}
.dui-cal-until {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);text-transform:uppercase;letter-spacing:.6px;margin-top:3px;}
.dui-week {display:grid;grid-auto-flow:column;grid-auto-columns:1fr;border-top:3px solid #000;height:calc(100% - 32px);}
.dui-day {display:flex;flex-direction:column;gap:4px;padding:8px 10px 0;border-right:1px solid #000;min-width:0;}
.dui-day:last-child {border-right:0;}
.dui-day--today {background:#000;color:#fff;}
.dui-day-name {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);letter-spacing:1px;text-transform:uppercase;}
.dui-day-num {font-size:38px;font-weight:780;line-height:1;letter-spacing:-1.5px;margin-bottom:4px;}
.dui-day-item {font-size:17px;line-height:21px;padding-top:4px;border-top:1px solid currentColor;}
.dui-part-time {display:block;font-weight:750;}
.dui-part-value {display:block;font-size:28px;font-weight:780;line-height:31px;letter-spacing:-.8px;white-space:nowrap;}
.dui-part-list span {display:block;padding-left:.6em;text-indent:-.6em;}
.dui-part-list span::before {content:'•';display:inline-block;width:.6em;text-indent:0;}
.dui-part-badge {align-self:flex-start;font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:21px;letter-spacing:.6px;text-transform:uppercase;white-space:nowrap;border:2px solid currentColor;border-radius:4px;padding:2px 6px;margin-top:4px;}
.dui-part-bar {display:block;position:relative;height:12px;margin:3px 0 1px;border:1px solid #000;border-radius:999px;background:#fff;overflow:hidden;}
.dui-part-bar span {position:absolute;top:0;bottom:0;min-width:10px;border-radius:999px;}
.dui-month {display:grid;grid-template-columns:repeat(7,1fr);grid-auto-rows:40px;gap:2px 4px;text-align:center;}
.dui-dow {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:30px;border-bottom:2px solid #000;}
.dui-mday {font-size:19px;font-weight:600;line-height:34px;margin:3px auto 0;width:36px;height:36px;border:2px solid transparent;border-radius:50%;}
.dui-mday--marked {border-color:#000;font-weight:780;}
.dui-mday--today {background:#000;color:#fff;font-weight:780;}
.dui-wx {width:1.35em;height:1.35em;object-fit:contain;vertical-align:-.3em;flex:none;}
.dui-wx--inline {margin-right:.25em;}
.dui-value .dui-wx,.dui-day-num .dui-wx,.dui-part-value .dui-wx {width:.75em;height:.75em;vertical-align:.02em;margin-right:0;margin-left:.15em;}
.dui-chart {display:grid;grid-template-columns:repeat(var(--n),1fr);grid-template-rows:auto 1fr;gap:8px 12px;height:calc(100% - 32px);--pill-min:72px;--pill-h:84px;}
.dui-chart--now {grid-template-columns:170px repeat(var(--n),1fr);}
.dui-chart--icons {--pill-min:120px;}
.dui-chart-label {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);text-align:center;white-space:nowrap;text-transform:uppercase;}
.dui-chart-label:first-child {text-align:left;}
.dui-plot {position:relative;min-height:0;}
.dui-plot-in {position:absolute;inset:0;}
.dui-chart--point .dui-plot-in {inset:calc(var(--pill-h)/2) 0;}
.dui-pill {position:absolute;left:0;right:0;border-radius:999px;display:flex;flex-direction:column;align-items:center;justify-content:space-evenly;padding:8px 0 10px;color:#000;}
.dui-chart--range .dui-pill {top:min(var(--y),calc(100% - var(--pill-min)));height:max(var(--s),var(--pill-min));}
.dui-chart--point .dui-pill {top:var(--y);height:var(--pill-h);transform:translateY(-50%);}
.dui-pill .dui-wx {width:36px;height:36px;vertical-align:0;}
.dui-chart--point .dui-pill .dui-wx {width:30px;height:30px;}
.dui-pill-value {font-size:26px;font-weight:780;line-height:1.1;letter-spacing:-.5px;}
.dui-pill--inverse {color:#fff;--framework-stroke-contrast:#000;}
/* Icons are black remote SVGs: invert them on dark ground, outlining first so they survive dithered fills. */
.dui-pill--inverse .dui-wx {filter:drop-shadow(1px 1px 0 #fff) drop-shadow(-1px -1px 0 #fff) drop-shadow(-1px 1px 0 #fff) drop-shadow(1px -1px 0 #fff) invert(1);}
.dui-day--today .dui-wx,.dui--spotlight .dui-block:first-child .dui-wx {filter:invert(1);}
:is(.screen--2bit,.screen--4bit) .dui-pill--inverse:is(.bg--gray-30,.bg--gray-45) {--framework-stroke-contrast:#555;}
.dui-pill--inverse .text-stroke {-webkit-text-stroke-color:var(--framework-stroke-contrast);}
.dui-now {position:absolute;left:0;right:14px;height:0;}
.dui-now-line {position:absolute;left:0;right:0;top:-1.5px;height:3px;background:#000;}
.dui-now-line::after {display:none;content:'';position:absolute;right:-14px;border:7px solid transparent;border-top-width:9px;border-bottom-width:9px;}
.dui-now--rising::after {display:block;border-bottom-color:#000;bottom:-1px;}
.dui-now--falling::after {display:block;border-top-color:#000;top:-1px;}
.dui-now-box {position:absolute;left:0;top:0;transform:translateY(-50%);background:#fff;padding-right:8px;}
.dui-now--below .dui-now-box {transform:translateY(10px);}
.dui-now--above .dui-now-box {transform:translateY(calc(-100% - 10px));}
.dui-now-value {font-size:64px;font-weight:780;line-height:1;letter-spacing:-2.5px;white-space:nowrap;}
.dui-now-label {font-size:var(--ui-meta-size);font-weight:var(--ui-meta-weight);line-height:var(--ui-meta-leading);white-space:nowrap;}
/* An editorial lead with a narrow supporting rail. */
.dui--editorial .dui-main {grid-template-columns:1.65fr 1fr;grid-template-rows:135px 1fr;gap:20px 30px;}
.dui--editorial .dui-block:first-child {grid-row:span 2;border-right:1px solid #000;padding-right:28px;}
.dui--editorial .dui-block:first-child .dui-label {font-family:Georgia,serif!important;text-transform:none;letter-spacing:-2px;font-size:49px;line-height:1.03;font-weight:400;margin-bottom:20px;}
.dui--editorial .dui-block:first-child .dui-body {font-size:19px;line-height:1.45;}
.dui--editorial .dui-value {font-size:53px;}
/* An oversized number anchors a narrow inverse column. */
.dui--spotlight .dui-main {grid-template-columns:.9fr 1.5fr;grid-template-rows:130px 1fr;gap:16px 28px;}
.dui--spotlight .dui-block:first-child {grid-row:span 2;background:#000;color:#fff;padding:22px 16px;display:flex;flex-direction:column;justify-content:space-between;}
.dui--spotlight .dui-block:first-child .dui-value {font-size:130px;line-height:1;letter-spacing:-5px;}
.dui--spotlight .dui-block:nth-child(2) .dui-label {font-size:25px;letter-spacing:-.6px;text-transform:none;line-height:1.15;}
.dui--spotlight .dui-block:nth-child(2) .dui-body {font-size:var(--ui-body-size);line-height:var(--ui-body-leading);}
.dui--spotlight .dui-event {padding:6px 0;}
/* A time-led composition with a checklist in the margin. */
.dui--timeline .dui-main {grid-template-columns:1.7fr 1fr;gap:38px;margin-top:28px;}
.dui--timeline .dui-block:first-child .dui-label {font-family:Georgia,serif!important;font-size:31px;text-transform:none;letter-spacing:-.6px;font-weight:400;margin-bottom:25px;}
.dui--timeline .dui-event {grid-template-columns:95px 1fr;padding:16px 0;}
.dui--timeline .dui-time {font-size:34px;line-height:38px;letter-spacing:-1px;}
.dui--timeline .dui-event-text {font-size:17px;line-height:23px;}
.dui--timeline .dui-block:nth-child(2) {border-left:1px solid #000;padding-left:24px;padding-top:5px;}
.dui--timeline .dui-list {gap:24px;}
/* Open columns of figures, followed by a short editorial note. */
.dui--scoreboard .dui-main {grid-template-columns:repeat(4,1fr);grid-template-rows:190px 1fr;gap:20px 15px;margin-top:34px;}
.dui--scoreboard .dui-block:nth-child(-n+4) {border-right:1px solid #000;padding-right:10px;}
.dui--scoreboard .dui-block:nth-child(4) {border:0;}
.dui--scoreboard .dui-value {font-size:72px;line-height:1.15;letter-spacing:-2px;margin:20px 0 12px;}
.dui--scoreboard .dui-block:last-child {grid-column:1/-1;border-top:3px solid #000;padding-top:14px;display:grid;grid-template-columns:1fr 2fr;gap:25px;}
.dui--scoreboard .dui-block:last-child .dui-label {font-family:Georgia,serif!important;font-size:27px;line-height:1.1;text-transform:none;letter-spacing:-.4px;font-weight:400;}
.dui--scoreboard .dui-block:last-child .dui-body {font-size:17px;line-height:1.4;}
/* A poster-like directive with a quiet definition of done. */
.dui--focus .dui-head {border-top:0;border-bottom:1px solid #000;padding:0 0 12px;}
.dui--focus .dui-main {grid-template-columns:1.8fr 1fr;align-items:center;gap:38px;margin-top:15px;}
.dui--focus .dui-block:first-child .dui-label {font-size:76px;line-height:.97;letter-spacing:-4px;text-transform:none;margin-bottom:24px;}
.dui--focus .dui-block:first-child .dui-body {font-size:17px;line-height:1.45;max-width:390px;}
.dui--focus .dui-block:nth-child(2) {border-top:5px solid #000;padding-top:15px;}
.dui--focus .dui-list {gap:22px;}
/* A compact newspaper lead above two distinct information columns. */
.dui--dispatch .dui-heading {font-family:Georgia,serif!important;font-size:27px;text-transform:none;letter-spacing:-1px;font-weight:400;line-height:30px;}
.dui--dispatch .dui-main {grid-template-columns:1.35fr 1fr;grid-template-rows:130px 1fr;gap:18px 28px;}
.dui--dispatch .dui-block:first-child {grid-column:1/-1;border-bottom:3px solid #000;padding-bottom:15px;}
.dui--dispatch .dui-block:first-child .dui-label {font-family:Georgia,serif!important;font-size:32px;line-height:36px;text-transform:none;letter-spacing:-.8px;font-weight:400;margin-bottom:9px;}
.dui--dispatch .dui-block:first-child .dui-body {font-size:var(--ui-body-size);line-height:var(--ui-body-leading);}
.dui--dispatch .dui-block:last-child {border-left:1px solid #000;padding-left:22px;}
/* A month grid beside the dates it marks. */
.dui--almanac .dui-main {grid-template-columns:1.15fr 1fr;gap:30px;}
.dui--almanac .dui-block:first-child {border-right:1px solid #000;padding-right:28px;}
.dui--almanac .dui-block:first-child .dui-label {font-family:Georgia,serif!important;font-size:31px;text-transform:none;letter-spacing:-.6px;font-weight:400;line-height:34px;margin-bottom:6px;}
/* Seven open columns with a short interpretation underneath; outlook and trend reuse it for range charts. */
:is(.dui--weekahead,.dui--outlook,.dui--trend) .dui-main {grid-template-rows:1fr auto;gap:16px;margin-top:18px;}
:is(.dui--weekahead,.dui--outlook,.dui--trend) .dui-block:last-child {border-top:3px solid #000;padding-top:12px;display:grid;grid-template-columns:1fr 2.2fr;gap:25px;}
:is(.dui--weekahead,.dui--outlook,.dui--trend) .dui-block:last-child .dui-label {font-family:Georgia,serif!important;font-size:27px;line-height:1.1;text-transform:none;letter-spacing:-.4px;font-weight:400;}
:is(.dui--weekahead,.dui--outlook,.dui--trend) .dui-block:last-child .dui-body {font-size:17px;line-height:1.4;}
.dui--weekahead .dui-week {border-bottom:1px solid #000;}
/* Full-height columns, one per person, project or day. */
.dui--board .dui-main {grid-template-rows:1fr;margin-top:18px;}
/* A lead line above calendar leaves counting down to each date. */
.dui--countdown .dui-main {grid-template-rows:auto 1fr;gap:20px;}
.dui--countdown .dui-block:first-child .dui-label {font-family:Georgia,serif!important;font-size:38px;line-height:42px;text-transform:none;letter-spacing:-1px;font-weight:400;margin-bottom:8px;}
.dui--countdown .dui-block:first-child .dui-body {font-size:var(--ui-body-size);line-height:var(--ui-body-leading);}
.dui--countdown .dui-cal {display:grid;grid-auto-flow:column;grid-auto-columns:1fr;border-top:3px solid #000;height:calc(100% - 32px);}
.dui--countdown .dui-cal-item {display:flex;flex-direction:column;align-items:flex-start;gap:6px;border-top:0;border-right:1px solid #000;padding:14px 16px 0;}
.dui--countdown .dui-cal-item:first-child {padding-left:0;}
.dui--countdown .dui-cal-item:last-child {border-right:0;}
.dui--countdown .dui-cal-leaf {display:grid;grid-template-columns:auto auto;grid-template-rows:auto auto;align-content:center;column-gap:10px;}
.dui--countdown .dui-cal-leaf .dui-cal-day {grid-row:1/3;grid-column:1;}
.dui--countdown .dui-cal-leaf .dui-cal-month {grid-column:2;align-self:end;}
.dui--countdown .dui-cal-leaf .dui-cal-month + .dui-cal-day + .dui-cal-month {align-self:start;}
.dui--countdown .dui-cal-day {font-size:64px;letter-spacing:-3px;}
.dui--countdown .dui-cal-until {margin:0 0 4px;}
</style>
<div class="dui dui--{{ layout | escape }}">@@WX_TABLES@@
<header class="dui-head"><span class="dui-heading">{{ heading | truncate:44 | escape }}</span><span class="dui-date">{{ updated_at | truncate:32 | escape }}</span></header>
<main class="dui-main">
{% for block in blocks limit:5 %}<section class="dui-block">
<div class="dui-label">{% if block.type == 'brief' %}{% if block.icon %}@@WX(block.icon|dui-wx dui-wx--inline)@@{% endif %}{% endif %}{{ block.title | truncate:32 | escape }}</div>
{% case block.type %}
{% when 'brief' %}<div class="dui-body">{{ block.text | truncate:180 | escape }}</div>
{% when 'metric' %}<div class="dui-value">{{ block.value | truncate:12 | escape }}{% if block.icon %}@@WX(block.icon|dui-wx)@@{% endif %}</div><div class="dui-sub">{{ block.text | truncate:64 | escape }}</div>
{% when 'list' %}<div class="dui-list">{% for item in block.items limit:3 %}<div class="dui-item"><span class="dui-index">0{{ forloop.index }}</span><span>{% if item.text %}{% if item.icon %}@@WX(item.icon|dui-wx dui-wx--inline)@@{% endif %}{{ item.text | truncate:48 | escape }}{% else %}{{ item | truncate:48 | escape }}{% endif %}</span></div>{% endfor %}</div>
{% when 'agenda' %}<div class="dui-events">{% for item in block.items limit:3 %}<div class="dui-event"><span class="dui-time">{{ item.time | truncate:8 | escape }}</span><span class="dui-event-text">{% if item.icon %}@@WX(item.icon|dui-wx dui-wx--inline)@@{% endif %}{{ item.text | truncate:38 | escape }}</span></div>{% endfor %}</div>
{% when 'table' %}<table class="dui-table"><thead><tr>{% for cell in block.headers limit:3 %}<th>{{ cell | truncate:18 | escape }}</th>{% endfor %}</tr></thead><tbody>{% for row in block.rows limit:3 %}<tr>{% for cell in row limit:3 %}<td>{{ cell | truncate:24 | escape }}</td>{% endfor %}</tr>{% endfor %}</tbody></table>
{% when 'dates' %}<div class="dui-cal">{% for item in block.items limit:4 %}<div class="dui-cal-item"><div class="dui-cal-leaf"><span class="dui-cal-month">{{ item.month | truncate:4 | escape }}</span><span class="dui-cal-day">{{ item.day | truncate:2 | escape }}</span>{% if item.weekday %}<span class="dui-cal-month">{{ item.weekday | truncate:3 | escape }}</span>{% endif %}</div><div>{% if item.until %}<div class="dui-cal-until">{{ item.until | truncate:12 | escape }}</div>{% endif %}<div class="dui-cal-text">{% if item.icon %}@@WX(item.icon|dui-wx dui-wx--inline)@@{% endif %}{{ item.text | truncate:36 | escape }}</div></div></div>{% endfor %}</div>
{% when 'week' %}<div class="dui-week">{% for d in block.days limit:7 %}<div class="dui-day{% if d.today == true %} dui-day--today{% endif %}"><span class="dui-day-name">{{ d.weekday | truncate:3 | escape }}</span><span class="dui-day-num">{{ d.day | truncate:2 | escape }}{% if d.icon %}@@WX(d.icon|dui-wx)@@{% endif %}</span>{% for e in d.items limit:2 %}<span class="dui-day-item">{{ e | truncate:18 | escape }}</span>{% endfor %}</div>{% endfor %}</div>
{% when 'columns' %}{% liquid
assign found = false
for col in block.columns limit:8
  for p in col.content limit:6
    if p.kind == 'range'
      if found == false
        assign hi = p.high
        assign lo = p.low
        assign found = true
      endif
      if p.high > hi
        assign hi = p.high
      endif
      if p.low < lo
        assign lo = p.low
      endif
    endif
  endfor
endfor
assign k = 0
if found
  assign span = hi | minus: lo
  if span > 0
    assign k = 100.0 | divided_by: span
  endif
endif
%}<div class="dui-week">{% for col in block.columns limit:8 %}<div class="dui-day{% if col.highlight == true %} dui-day--today{% endif %}"><span class="dui-day-name">{{ col.label | truncate:12 | escape }}</span>{% if col.value or col.icon %}<span class="dui-day-num">{{ col.value | truncate:4 | escape }}{% if col.icon %}@@WX(col.icon|dui-wx)@@{% endif %}</span>{% endif %}{% for p in col.content limit:6 %}{% case p.kind %}
{% when 'text' %}<span class="dui-day-item">{% if p.icon %}@@WX(p.icon|dui-wx dui-wx--inline)@@{% endif %}{{ p.text | truncate:60 | escape }}</span>
{% when 'event' %}<span class="dui-day-item"><b class="dui-part-time">{{ p.time | truncate:8 | escape }}</b>{% if p.icon %}@@WX(p.icon|dui-wx dui-wx--inline)@@{% endif %}{{ p.text | truncate:48 | escape }}</span>
{% when 'metric' %}<span class="dui-day-item"><b class="dui-part-value">{{ p.value | truncate:5 | escape }}{% if p.icon %}@@WX(p.icon|dui-wx)@@{% endif %}</b>{{ p.text | truncate:24 | escape }}</span>
{% when 'list' %}<span class="dui-day-item dui-part-list">{% for e in p.items limit:3 %}<span>{{ e | truncate:24 | escape }}</span>{% endfor %}</span>
{% when 'badge' %}<span class="dui-part-badge">{{ p.text | truncate:12 | escape }}</span>
{% when 'range' %}{% if k > 0 %}{% assign x = p.low | minus: lo | times: k %}{% assign w = p.high | minus: p.low | times: k %}{% else %}{% assign x = 0 %}{% assign w = 100 %}{% endif %}@@RANGE_LEVEL_CASE@@<span class="dui-day-item"><b>{{ p.low }}–{{ p.high }}{{ block.unit | truncate:4 | escape }}</b><span class="dui-part-bar"><span class="bg--gray-{{ shade }}" style="left:{{ x | round:1 }}%;width:{{ w | round:1 }}%"></span></span></span>
{% endcase %}{% endfor %}</div>{% endfor %}</div>
{% when 'month' %}{% assign lead = block.first_weekday | at_least:1 | at_most:7 | minus:1 %}{% assign last = block.days_in_month | at_least:28 | at_most:31 %}<div class="dui-month"><span class="dui-dow">M</span><span class="dui-dow">T</span><span class="dui-dow">W</span><span class="dui-dow">T</span><span class="dui-dow">F</span><span class="dui-dow">S</span><span class="dui-dow">S</span>{% for i in (1..lead) %}<span></span>{% endfor %}{% for d in (1..last) %}<span class="dui-mday{% if block.marked contains d %} dui-mday--marked{% endif %}{% if d == block.today %} dui-mday--today{% endif %}">{{ d }}</span>{% endfor %}</div>
{% when 'forecast','range' %}{% liquid
if block.type == 'forecast'
  assign items = block.periods
  assign nowv = block.now.temp
else
  assign items = block.bars
  assign nowv = block.now.value
endif
assign hi = items.first.low
assign lo = items.first.low
for p in items limit:7
  assign h = p.high | default: p.low
  if h > hi
    assign hi = h
  endif
  if p.low < lo
    assign lo = p.low
  endif
endfor
if block.now
  if nowv > hi
    assign hi = nowv
  endif
  if nowv < lo
    assign lo = nowv
  endif
endif
assign span = hi | minus: lo
assign k = 0
if span > 0
  assign k = 100.0 | divided_by: span
endif
%}<div class="dui-chart dui-chart--{{ block.mode | default: 'range' }}{% if block.now %} dui-chart--now{% endif %}{% if block.type == 'forecast' %} dui-chart--icons{% endif %}" style="--n:{{ items.size | at_most:7 }}">{% if block.now %}<span class="dui-chart-label">{{ block.unit | truncate:4 | escape }}</span>{% endif %}{% for p in items limit:7 %}<span class="dui-chart-label">{{ p.label | truncate:6 | escape }}</span>{% endfor %}
{% if block.now %}{% if span > 0 %}{% assign y = hi | minus: nowv | times: k %}{% else %}{% assign y = 50 %}{% endif %}<div class="dui-plot"><div class="dui-plot-in"><div class="dui-now{% if y < 25 %} dui-now--below{% elsif y > 75 %} dui-now--above{% endif %}" style="top:{{ y | round:1 }}%"><div class="dui-now-line dui-now--{{ block.now.trend | default: 'steady' | escape }}"></div><div class="dui-now-box"><div class="dui-now-value">{% if block.type == 'forecast' %}{{ nowv | round }}°{% else %}{{ nowv }}{% endif %}</div>{% if block.now.label %}<div class="dui-now-label">{{ block.now.label | truncate:10 | escape }}</div>{% endif %}</div></div></div></div>{% endif %}
{% for p in items limit:7 %}{% assign h = p.high | default: p.low %}{% if span > 0 %}{% assign y = hi | minus: h | times: k %}{% assign size = h | minus: p.low | times: k %}{% elsif block.mode == 'point' %}{% assign y = 50 %}{% assign size = 0 %}{% else %}{% assign y = 0 %}{% assign size = 100 %}{% endif %}{% if block.type == 'forecast' %}@@WX_SHADE(p.condition)@@{% assign hv = h | round %}{% assign lv = p.low | round %}{% else %}@@RANGE_LEVEL_CASE@@{% assign hv = h %}{% assign lv = p.low %}{% endif %}{% assign stroke = '' %}{% if shade <= @@INVERSE_AT_OR_BELOW@@ %}{% if shade <= 25 %}{% assign stroke = 'text-stroke text-stroke--black' %}{% else %}{% assign stroke = 'text-stroke text-stroke--black 2bit:text-stroke--gray-30 4bit:text-stroke--gray-30' %}{% endif %}{% endif %}<div class="dui-plot"><div class="dui-plot-in"><div class="dui-pill bg--gray-{{ shade }}{% if shade <= @@INVERSE_AT_OR_BELOW@@ %} dui-pill--inverse{% endif %}" style="--y:{{ y | round:1 }}%;--s:{{ size | round:1 }}%">{% if block.type == 'forecast' %}@@WX(p.condition|dui-wx)@@{% endif %}{% if hv != lv %}<span class="dui-pill-value {{ stroke }}">{{ hv }}</span>{% endif %}<span class="dui-pill-value {{ stroke }}">{{ lv }}</span></div></div></div>{% endfor %}</div>
{% endcase %}</section>{% endfor %}
</main>
</div>
