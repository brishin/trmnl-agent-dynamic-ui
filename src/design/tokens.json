{
  "name": "agent dynamic UI",
  "version": 2,
  "screen": {
    "width_px": 800,
    "height_px": 480,
    "inset_px": 24
  },
  "typography": {
    "minimum_font_size_px": 16,
    "small_text_max_size_px": 16,
    "small_text_min_weight": 600,
    "sans": "Arial, Helvetica, sans-serif",
    "serif": "Georgia, serif",
    "serif_display_weight": 400,
    "styles": {
      "label": {"size": 16, "weight": 700, "line_height": 22, "tracking": 1, "uppercase": true},
      "body": {"size": 18, "weight": 400, "line_height": 26, "tracking": 0},
      "subtitle": {"size": 24, "weight": 700, "line_height": 30, "tracking": -0.3},
      "title": {"size": 32, "weight": 700, "line_height": 36, "tracking": -0.6},
      "headline": {"size": 48, "weight": 700, "line_height": 52, "tracking": -1.5},
      "display": {"size": 76, "weight": 800, "line_height": 78, "tracking": -3.5}
    },
    "figures": {
      "s": 28,
      "m": 42,
      "l": 64,
      "xl": 96,
      "xxl": 130
    },
    "figure_weight": 800,
    "figure_tracking_em": -0.04
  },
  "spacing": {
    "unit_px": 4,
    "scale": {"none": 0, "xs": 4, "sm": 8, "md": 16, "lg": 24, "xl": 40}
  },
  "rules": {"thin": 1, "medium": 3, "thick": 5},
  "icons": {"s": 24, "m": 36, "l": 64, "xl": 112},
  "bars": {"height_px": 14, "large_height_px": 36, "min": {"s": 32, "m": 64, "l": 104}},
  "ink": {
    "foreground": "#000000",
    "background": "#ffffff",
    "fills": {
      "gray_steps": [15, 30, 45, 55, 60, 65, 70, 75],
      "class": "bg--gray-NN",
      "inverse_at_or_below": 55,
      "use": "only on .s-bar-fill; text on fills at or below the inverse step turns white with a black outline"
    }
  },
  "limits": {
    "max_markup_bytes": 60000,
    "max_inverse_regions": 1,
    "max_type_sizes": 4,
    "max_display_chars": 40
  },
  "prohibited": [
    "microtext",
    "gray text",
    "decorative bottom footer",
    "per-screen CSS or <style>",
    "scripts, event handlers or external resources",
    "text auto-shrinking below the minimum"
  ]
}
