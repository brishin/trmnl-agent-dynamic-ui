{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Dynamic UI v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "heading": {
      "type": "string",
      "minLength": 1,
      "maxLength": 44
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "brief"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 180
              }
            },
            "required": [
              "type",
              "title",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "metric"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "type",
              "title",
              "value",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "list"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 48
                }
              }
            },
            "required": [
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "agenda"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "time": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 38
                    }
                  },
                  "required": [
                    "time",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "table"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "headers": {
                "type": "array",
                "minItems": 2,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18
                }
              },
              "rows": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 3,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 24
                  }
                }
              }
            },
            "required": [
              "type",
              "title",
              "headers",
              "rows"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "dates"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "month": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4
                    },
                    "day": {
                      "type": "string",
                      "pattern": "^[0-9]{1,2}$"
                    },
                    "weekday": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 36
                    },
                    "until": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 12
                    }
                  },
                  "required": [
                    "month",
                    "day",
                    "text"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "title",
              "items"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "week"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "days": {
                "type": "array",
                "minItems": 5,
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "properties": {
                    "weekday": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 3
                    },
                    "day": {
                      "type": "string",
                      "pattern": "^[0-9]{1,2}$"
                    },
                    "today": {
                      "type": "boolean"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 2,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 18
                      }
                    }
                  },
                  "required": [
                    "weekday",
                    "day"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "title",
              "days"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "month"
              },
              "width": {
                "enum": [
                  "half",
                  "full"
                ]
              },
              "emphasis": {
                "enum": [
                  "normal",
                  "important"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "first_weekday": {
                "type": "integer",
                "minimum": 1,
                "maximum": 7
              },
              "days_in_month": {
                "type": "integer",
                "minimum": 28,
                "maximum": 31
              },
              "today": {
                "type": "integer",
                "minimum": 1,
                "maximum": 31
              },
              "marked": {
                "type": "array",
                "maxItems": 10,
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 31
                }
              }
            },
            "required": [
              "type",
              "title",
              "first_weekday",
              "days_in_month"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "layout": {
      "enum": [
        "editorial",
        "spotlight",
        "timeline",
        "scoreboard",
        "focus",
        "dispatch",
        "almanac",
        "weekahead",
        "countdown"
      ]
    }
  },
  "required": [
    "schema_version",
    "heading",
    "updated_at",
    "blocks",
    "layout"
  ],
  "additionalProperties": false
}
