        "showers",
        "heavy-showers",
        "freezing-drizzle",
        "sleet",
        "light-rain",
        "rain",
        "heavy-rain",
        "freezing-rain",
        "heavy-freezing-rain",
        "light-snow",
        "snow",
        "heavy-snow",
        "thunderstorm",
        "hail",
