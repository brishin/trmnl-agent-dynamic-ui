{
  "name": "agent dynamic UI",
  "version": 1,
  "typography": {
    "minimum_font_size_px": 16,
    "small_text_max_size_px": 16,
    "small_text_min_weight": 600,
    "metadata": {
      "size": 16,
      "weight": 700,
      "line_height": 22
    },
    "body": {
      "size": 18,
      "weight": 400,
      "line_height": 26
    },
    "section": {
      "size": 18,
      "weight": 700,
      "line_height": 24
    }
  },
  "ink": {
    "foreground": "#000000",
    "background": "#ffffff"
  },
  "spacing": {
    "unit_px": 4,
    "screen_inset_px": 24
  },
  "prohibited": [
    "microtext",
    "light small text",
    "decorative bottom footer",
    "per-payload CSS",
    "text auto-shrinking below the minimum"
  ]
}
